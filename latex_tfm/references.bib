@article{Smith_2006,
title = {Pure pseudo-Cℓ estimators for CMB B-modes},
journal = {New Astronomy Reviews},
volume = {50},
number = {11},
pages = {1025-1029},
year = {2006},
note = {Fundamental Physics with Cosmic Microwave Background Radiation},
issn = {1387-6473},
doi = {https://doi.org/10.1016/j.newar.2006.09.015},
url = {https://www.sciencedirect.com/science/article/pii/S138764730600220X},
author = {Kendrick M. Smith},
keywords = {Cosmology, Theory, Cosmic microwave background, Polarization},
abstract = {Fast heuristically weighted, or pseudo-Cℓ, estimators are a frequently used method for estimating power spectra in CMB surveys with large numbers of pixels. Recently, Challinor and Chon showed that the E–B mixing in these estimators can become a dominant contaminant at low noise levels, ultimately limiting the gravity wave signal which can be detected on a finite patch of sky. We define a modified version of the estimators which eliminates E–B mixing and is near-optimal at all noise levels.}
}

